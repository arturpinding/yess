# Local defaults only. Replace every secret in deployed environments.
DATABASE_URL=postgres://rada:rada_dev_only@127.0.0.1:5432/rada
SESSION_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNING_SECRET=replace-with-a-different-32-character-secret
APP_ORIGIN=http://localhost:3000
DEFAULT_COUNTRY=EE
LOG_LEVEL=info

# Optional local phone-camera demo overrides. dev:phone auto-selects an active
# private IPv4 address and uses these non-privileged ports when omitted.
# PHONE_DEMO_HOST=192.168.1.42
# PHONE_DEMO_PORT=3000
# PHONE_DEMO_CA_PORT=3080

# Phone broadcasting is disabled in production unless explicitly enabled.
# `direct` is the local one-viewer fallback and requires authenticated TURN in production.
# `livekit-cloud` is the Vercel-compatible, managed one-to-many path.
PHONE_BROADCAST_ENABLED=false
PHONE_BROADCAST_PROVIDER=direct
# PHONE_BROADCAST_ICE_SERVERS_JSON=[{"urls":["turn:turn.example.test:3478?transport=udp","turns:turn.example.test:443?transport=tcp"],"username":"short-lived-user","credential":"short-lived-credential"}]
# PHONE_BROADCAST_ACCESS_KEY=replace-with-a-strong-private-broadcaster-key
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=replace-with-server-only-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-server-only-livekit-api-secret

# Optional production adapters. Empty means the documented development adapter is used.
REDIS_URL=
PAYMENT_PROVIDER=
PUSH_PROVIDER=
EMAIL_PROVIDER=

# Functional local FFmpeg provider. The built-in token is development-only.
MEDIA_PROVIDER_URL=http://127.0.0.1:8090
MEDIA_PROVIDER_TOKEN=rada-local-media-provider-development-only
LOCAL_MEDIA_PROVIDER_HOST=127.0.0.1
LOCAL_MEDIA_PROVIDER_PORT=8090
LOCAL_MEDIA_PROVIDER_PUBLIC_URL=http://127.0.0.1:8090
